# Copy to backend/.env — every value is optional.

# AI provider (any OpenAI-compatible API). Leave empty to use the built-in rules engine.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Razorpay TEST keys. Leave empty to use the built-in test checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PORT=5000
FRONTEND_URL=http://localhost:3000
